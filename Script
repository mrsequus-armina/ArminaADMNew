-- Button builder with smooth hover & click feedback
local function btn(text, y, color, parentFrame, height)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, height or 38)
	b.Position = UDim2.new(0, 0, 0, y)
	b.BackgroundColor3 = color
	b.Text = text
	b.TextColor3 = Theme.Text
	b.TextSize = 14
	b.Font = Enum.Font.GothamSemibold
	b.AutoButtonColor = false
	b.Parent = parentFrame or ScanPage
	addCorner(b, 10)

	local stroke = addStroke(b, Color3.fromRGB(255, 255, 255), 1, 0.85)
	local baseColor = color
	local hoverColor = color:Lerp(Color3.fromRGB(255, 255, 255), 0.14)
	local pressColor = color:Lerp(Color3.fromRGB(0, 0, 0), 0.16)

	b.MouseEnter:Connect(function()
		tween(b, TweenInfo.new(0.14), { BackgroundColor3 = hoverColor })
		tween(stroke, TweenInfo.new(0.14), { Transparency = 0.55 })
	end)
	b.MouseLeave:Connect(function()
		tween(b, TweenInfo.new(0.14), { BackgroundColor3 = baseColor })
		tween(stroke, TweenInfo.new(0.14), { Transparency = 0.85 })
	end)
	b.MouseButton1Down:Connect(function()
		tween(b, TweenInfo.new(0.08), { BackgroundColor3 = pressColor })
	end)
	b.MouseButton1Up:Connect(function()
		tween(b, TweenInfo.new(0.12), { BackgroundColor3 = hoverColor })
	end)

	return b
end

