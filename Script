-- ===================== CORE SCAN =====================
local function scanHouse()
	if isScanning then return end
	isScanning = true
	ScannedLayout = {}
	estimatedCost = 0
	HouseName = "Unknown"
	setProgress(0)
	setStatus("Scanning radius around you…", C.AccentBright)
	updateInfo()

	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then
		setStatus("Character not found", C.Red)
		isScanning = false
		return
	end

	local hrp = char.HumanoidRootPart
	local originPos = hrp.Position
	HouseOrigin = CFrame.new(originPos)

	local parts = {}
	local seen = {}
	local SCAN_RADIUS = 85

	for _, obj in ipairs(workspace:GetDescendants()) do
		if (obj:IsA("BasePart") or obj:IsA("MeshPart")) and not seen[obj] then
			if (obj.Position - originPos).Magnitude <= SCAN_RADIUS then
				if obj.Transparency < 0.97 and not obj:IsDescendantOf(char) then
					if obj.Size.Magnitude > 0.15 then
						seen[obj] = true
						table.insert(parts, obj)
					end
				end
			end
		end
	end

	local extraFolders = {"Furniture", "Decor", "Interior", "HouseFurniture", "PlacedItems"}
	for _, folderName in ipairs(extraFolders) do
		local folder = workspace:FindFirstChild(folderName) or workspace:FindFirstChild(folderName, true)
		if folder then
			for _, obj in ipairs(folder:GetDescendants()) do
				if (obj:IsA("BasePart") or obj:IsA("MeshPart")) and not seen[obj] then
					if (obj.Position - originPos).Magnitude <= SCAN_RADIUS + 10 then
						seen[obj] = true
						table.insert(parts, obj)
					end
				end
			end
		end
	end

	local total = #parts
	if total < 10 then
		setStatus("Only " .. total .. " parts found. Move deeper inside.", C.Amber)
		isScanning = false
		updateInfo()
		return
	end

	local bestModel, bestCount = nil, 0
	for _, obj in ipairs(workspace:GetChildren()) do
		if obj:IsA("Model") then
			local count = 0
			for _, d in ipairs(obj:GetDescendants()) do
				if d:IsA("BasePart") then count += 1 end
			end
			if count > bestCount and (obj:GetBoundingBox().Position - originPos).Magnitude < 60 then
				bestCount = count
				bestModel = obj
			end
		end
	end

	if bestModel then
		HouseName = bestModel.Name
		if HouseName == "" or HouseName == "Model" then
			HouseName = "Large Custom House"
		end
	else
		HouseName = "Custom / Streamed House"
	end

	setStatus(string.format("Found %d parts – processing…", total), C.AccentBright)

	for i, part in ipairs(parts) do
		local rel = HouseOrigin:ToObjectSpace(part.CFrame)
		table.insert(ScannedLayout, {
			rel = {rel:GetComponents()},
			size = {part.Size.X, part.Size.Y, part.Size.Z},
			color = {part.Color.R, part.Color.G, part.Color.B},
			material = tostring(part.Material),
			transparency = part.Transparency,
			name = part.Name,
			class = part.ClassName,
			anchored = part.Anchored,
			cancollide = part.CanCollide,
		})

		if i % 30 == 0 or i == total then
			setProgress(i / total)
			setStatus(string.format("Scanning %d / %d", i, total), C.AccentBright)
			updateInfo()
			RunService.Heartbeat:Wait()
		end
	end

	setProgress(1)
	updateInfo()
	setStatus(string.format("Scanned %d parts", #ScannedLayout), C.Green)
	isScanning = false
end

-- ===================== GHOST & BUILD =====================
local function clearGhost()
	if GhostFolder then
		GhostFolder:Destroy()
		GhostFolder = nil
	end
end

local function spawnGhost()
	if #ScannedLayout == 0 then
		setStatus("Scan first", C.Red)
		return
	end
	clearGhost()
	GhostFolder = Instance.new("Folder")
	GhostFolder.Name = "GhostPreview"
	GhostFolder.Parent = workspace

	ProgressCard.Visible = true
	ProgHeader.Text = HouseName
	ProgSub.Text = "Ghost Preview"
	ProgCostLbl.Text = "$0"
	CheckListText.Text = "✓ Layout loaded\n• Spawning non-collidable preview parts\n• Zero Bucks spent"

	setStatus("Building free ghost preview…", C.AccentBright)
	local origin = HouseOrigin
	local stepSize = 50 * buildSpeedMultiplier

	for i, data in ipairs(ScannedLayout) do
		local part = Instance.new("Part")
		part.Size = Vector3.new(unpack(data.size))
		part.Color = Color3.new(unpack(data.color))
		pcall(function()
			local matName = data.material:match("%.(.+)$") or data.material
			part.Material = Enum.Material[matName] or Enum.Material.Plastic
		end)
		part.Transparency = 0.40
		part.Anchored = true
		part.CanCollide = false
		part.CastShadow = false
		part.Name = data.name or "GhostPart"
		part.CFrame = origin * CFrame.new(unpack(data.rel))
		part.Parent = GhostFolder

		if i % stepSize == 0 or i == #ScannedLayout then
			setProgress(i / #ScannedLayout)
			StepCounterLbl.Text = string.format("Processed: %d / %d", i, #ScannedLayout)
			RunService.Heartbeat:Wait()
		end
	end

	setProgress(1)
	CheckListText.Text = "✓ Layout loaded\n✓ Ghost preview spawned\n✓ Completely free"
	setStatus(string.format("Ghost ready (%d parts)", #ScannedLayout), C.AccentBright)
end

local function runBuildSequence(count)
	if #ScannedLayout == 0 then
		setStatus("Scan first", C.Red)
		return
	end
	if isBuilding then return end
	isBuilding = true
	cancelBuild = false

	ProgressCard.Visible = true
	ProgHeader.Text = HouseName
	ProgCostLbl.Text = "$" .. tostring(estimatedCost * count)

	local sellRemote = resolveRemote(RemotesConfig.SellFurniturePath)
	local buyHouseRemote = resolveRemote(RemotesConfig.BuyHousePath)
	local buyFurnRemote = resolveRemote(RemotesConfig.BuyFurnituresPath)

	for h = 1, count do
		if cancelBuild then break end
		ProgSub.Text = string.format("House %d/%d", h, count)
		setProgress(0)

		if not RemotesConfig.Enabled then
			CheckListText.Text = "• RemotesConfig.Enabled is false\n• Confirm inner {...} table schemas first\n• Running visual progress check"
			local stepSize = 40 * buildSpeedMultiplier
			for i = 1, #ScannedLayout do
				if cancelBuild then break end
				if i % stepSize == 0 or i == #ScannedLayout then
					setProgress(i / #ScannedLayout)
					StepCounterLbl.Text = string.format("Processed: %d / %d", i, #ScannedLayout)
					RunService.Heartbeat:Wait()
				end
			end
		else
			-- 1. Sell existing furniture: (false, {...}, "sell")
			CheckListText.Text = "• Selling existing furniture…\n• Buying house (" .. SelectedHouseId .. ")\n• Placing scanned furniture"
			invokeHousingRemote(sellRemote, false, {}, "sell")
			task.wait(0.25)

			-- 2. Buy house with addons: (houseId, {...}, Color3)
			CheckListText.Text = "✓ Old furniture sold\n• Buying house (" .. SelectedHouseId .. ")…\n• Placing scanned furniture"
			invokeHousingRemote(buyHouseRemote, SelectedHouseId, {}, RemotesConfig.DefaultHouseColor)
			task.wait(0.4)

			-- 3. Buy/place furniture via BuyFurnitures({...})
			CheckListText.Text = "✓ Old furniture sold\n✓ House bought (" .. SelectedHouseId .. ")\n• Placing scanned furniture…"
			for i, item in ipairs(ScannedLayout) do
				if cancelBuild then break end
				local relCf = CFrame.new(unpack(item.rel))
				local col = Color3.new(unpack(item.color))
				local payload = {
					{
						kind = item.name,
						cframe = HouseOrigin * relCf,
						color = col,
					},
				}
				invokeHousingRemote(buyFurnRemote, payload)

				if i % math.max(1, buildSpeedMultiplier) == 0 or i == #ScannedLayout then
					setProgress(i / #ScannedLayout)
					StepCounterLbl.Text = string.format("Processed: %d / %d", i, #ScannedLayout)
					task.wait(RemotesConfig.ItemDelay / buildSpeedMultiplier)
				end
			end
		end
	end

	if cancelBuild then
		CheckListText.Text = "! Build cancelled & refunded\n• No remaining items queued\n• Ready when you are"
		setStatus("Build cancelled & refunded", C.Amber)
	elseif not RemotesConfig.Enabled then
		CheckListText.Text = "✓ Visual check done\n! Enable RemotesConfig.Enabled after verifying\n  the inner {...} table keys"
		setStatus("Verify {...} table keys to fire live remotes", C.Amber)
	else
		CheckListText.Text = "✓ Sold old furniture\n✓ Bought house (" .. SelectedHouseId .. ")\n✓ Sent furniture placement calls"
		setStatus("Build sequence completed", C.Green)
	end

	cancelBuild = false
	isBuilding = false
end

local function realPlace()
	if #ScannedLayout == 0 then
		setStatus("Scan first", C.Red)
		return
	end
	selectedHouseCount = 1
	refreshModalCost()
	ModalBackdrop.Visible = true
end

local function tpToPlayer()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then table.insert(list, p) end
	end
	if #list == 0 then
		setStatus("No other players", C.Red)
		return
	end
	local target = list[math.random(#list)]
	if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
		LocalPlayer.Character.HumanoidRootPart.CFrame =
			target.Character.HumanoidRootPart.CFrame + Vector3.new(0, 6, 0)
		setStatus("Teleported near " .. target.Name, C.AccentBright)
	end
end

local function saveLayout()
	if #ScannedLayout == 0 then return end
	local data = {
		house = HouseName,
		houseId = SelectedHouseId,
		count = #ScannedLayout,
		cost = estimatedCost,
		origin = {HouseOrigin:GetComponents()},
		parts = ScannedLayout,
	}
	setclipboard(HttpService:JSONEncode(data))
	setStatus("Full layout copied to clipboard", C.Green)
end

local function loadLayout()
	local ok, data = pcall(function()
		return HttpService:JSONDecode(getclipboard())
	end)
	if ok and data and data.parts then
		ScannedLayout = data.parts
		HouseName = data.house or "Loaded"
		if data.houseId then
			SelectedHouseId = data.houseId
			HouseIdBox.Text = SelectedHouseId
		end
		estimatedCost = data.cost or computeCost()
		if data.origin then
			HouseOrigin = CFrame.new(unpack(data.origin))
		end
		updateInfo()
		setStatus(string.format("Loaded %d parts", #ScannedLayout), C.Green)
	else
		setStatus("Clipboard does not contain valid layout", C.Red)
	end
end

