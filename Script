-- Furniture cost counts each furniture MODEL once (not once per part),
-- using the price database. Free items are 0. House price is added on top.
local function computeCost()
	local total = 0
	local counted = {}
	for i, item in ipairs(ScannedLayout) do
		local key = item.model or item.name
		local _, price = getFurnitureInfo(key)
		if price then
			local instKey = item.inst or ("p" .. i)
			if not counted[instKey] then
				counted[instKey] = true
				total += price
			end
		else
			total += UNMATCHED_PART_COST
		end
	end
	furnitureCost = math.floor(total)
	local _, hp = describeHouse(SelectedHouseId)
	housePrice = hp or 0
	return furnitureCost + housePrice
end

