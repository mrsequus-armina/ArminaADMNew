	Enabled = false, -- set to true once inner {...} table schemas are confirmed
	SellFurniturePath = { "API", "HousingAPI/SellFurniture" },
	BuyHousePath = { "API", "HousingAPI/BuyHouseWithAddons" },
	BuyFurnituresPath = { "API", "HousingAPI/BuyFurnitures" },
	DefaultHouseColor = Color3.fromRGB(196, 40, 28),
	ItemDelay = 0.08,
}

local function resolveRemote(pathList)
	local cur = ReplicatedStorage
	for _, seg in ipairs(pathList) do
		if not cur then return nil end
		cur = cur:FindFirstChild(seg)
	end
	return cur
end

local function invokeHousingRemote(remote, ...)
	if not remote then
		return false, "Remote not found"
	end
	if remote:IsA("RemoteFunction") then
		return pcall(function(...)
			return remote:InvokeServer(...)
		end, ...)
	elseif remote:IsA("RemoteEvent") then
		return pcall(function(...)
			remote:FireServer(...)
		end, ...)
	end
	return false, "Unsupported remote class"
end

