-- ===================== CORE LOGIC =====================

local function getHouseRoot()
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
	local root = char.HumanoidRootPart
	local best = nil
	local bestDist = 40

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and (obj.Name:lower():find("house") or obj:GetAttribute("Owner") or obj:FindFirstChild("House") or obj:FindFirstChildWhichIsA("BasePart")) then
			local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
			if primary then
				local dist = (primary.Position - root.Position).Magnitude
				if dist < bestDist then
					bestDist = dist
					best = obj
				end
			end
		end
	end
	return best
end

local function scanHouse()
	if isScanning then return end
	isScanning = true
	ScannedLayout = {}
	setStatus("Scanning interior…", Color3.fromRGB(0, 180, 255))
	setProgress(0)

	local house = getHouseRoot()
	if not house then
		setStatus("No house found nearby. Stand inside it.", Color3.fromRGB(255, 80, 80))
		isScanning = false
		return
	end

	HouseOrigin = house:GetBoundingBox()
	local originCF, size = HouseOrigin
	local parts = {}

	-- Deep scan – this is the fix
	for _, desc in ipairs(house:GetDescendants()) do
		if desc:IsA("BasePart") and not desc:IsDescendantOf(LocalPlayer.Character) then
			-- skip pure terrain / invisible anchors if wanted
			if desc.Transparency < 0.99 or desc.CanCollide then
				table.insert(parts, desc)
			end
		end
	end

	-- Also grab any furniture models that might be parented under workspace but belong to this house (common in Adopt Me)
	for _, obj in ipairs(workspace:GetChildren()) do
		if obj:IsA("Model") and obj ~= house then
			local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
			if primary then
				local dist = (primary.Position - originCF.Position).Magnitude
				if dist < (size.Magnitude / 2 + 15) then
					for _, desc in ipairs(obj:GetDescendants()) do
						if desc:IsA("BasePart") then
							table.insert(parts, desc)
						end
					end
				end
			end
		end
	end

	local total = #parts
	if total == 0 then
		setStatus("0 parts found – try standing deeper inside", Color3.fromRGB(255, 120, 50))
		isScanning = false
		return
	end

	for i, part in ipairs(parts) do
		local rel = originCF:ToObjectSpace(part.CFrame)
		table.insert(ScannedLayout, {
			rel = {rel:GetComponents()},
			size = {part.Size.X, part.Size.Y, part.Size.Z},
			color = {part.Color.R, part.Color.G, part.Color.B},
			material = part.Material.Name,
			transparency = part.Transparency,
			name = part.Name,
			class = part.ClassName,
			anchored = part.Anchored,
			cancollide = part.CanCollide
		})
		if i % 50 == 0 then
			setProgress(i / total)
			setStatus(string.format("Scanning… %d / %d", i, total))
			RunService.Heartbeat:Wait()
		end
	end

	setProgress(1)
	setStatus(string.format("Scanned %d interior parts ✓", #ScannedLayout), Color3.fromRGB(80, 255, 120))
	isScanning = false
end

local function clearGhost()
	if GhostFolder then
		GhostFolder:Destroy()
		GhostFolder = nil
	end
end

local function spawnGhost()
	if #ScannedLayout == 0 then
		setStatus("Scan first", Color3.fromRGB(255, 100, 100))
		return
	end
	clearGhost()

	GhostFolder = Instance.new("Folder")
	GhostFolder.Name = "GhostHousePreview"
	GhostFolder.Parent = workspace

	local origin = HouseOrigin or CFrame.new(LocalPlayer.Character.HumanoidRootPart.Position)

	for i, data in ipairs(ScannedLayout) do
		local part = Instance.new(data.class or "Part")
		part.Size = Vector3.new(unpack(data.size))
		part.Color = Color3.new(unpack(data.color))
		part.Material = Enum.Material[data.material] or Enum.Material.Plastic
		part.Transparency = 0.45
		part.Anchored = true
		part.CanCollide = false
		part.CastShadow = false
		part.Name = data.name or "GhostPart"

		local rel = CFrame.new(unpack(data.rel))
		part.CFrame = origin * rel
		part.Parent = GhostFolder

		if i % 80 == 0 then
			setProgress(i / #ScannedLayout)
			RunService.Heartbeat:Wait()
		end
	end

	setProgress(1)
	setStatus(string.format("Ghost preview active (%d parts) – free / client only", #ScannedLayout), Color3.fromRGB(180, 220, 255))
end

local function realPlace()
	if #ScannedLayout == 0 then
		setStatus("Scan first", Color3.fromRGB(255, 100, 100))
		return
	end
	if isPlacing then return end
	isPlacing = true
	setStatus("Placing for real (this may cost bucks)…", Color3.fromRGB(255, 200, 50))

	-- This is a simplified real-place. In practice you fire the game’s place remote.
	-- Most public cloners just recreate the visual layout client-side for preview
	-- and rely on the game’s own placement for the paid version.
	-- For a true server place you would need the current remote path (it rotates).

	setStatus("Real place requires current remote – use Ghost for free preview", Color3.fromRGB(255, 160, 60))
	isPlacing = false
end

local function tpToPlayer()
	local list = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			table.insert(list, plr.Name)
		end
	end
	if #list == 0 then
		setStatus("No other players", Color3.fromRGB(255, 100, 100))
		return
	end

	-- Simple picker
	local chosen = list[1] -- you can expand this into a dropdown later
	local target = Players:FindFirstChild(chosen)
	if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
		LocalPlayer.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame + Vector3.new(0, 5, 0)
		setStatus("Teleported to " .. chosen, Color3.fromRGB(180, 120, 255))
	end
end

local function saveLayout()
	if #ScannedLayout == 0 then return end
	local json = HttpService:JSONEncode({
		origin = {HouseOrigin:GetComponents()},
		parts = ScannedLayout
	})
	setclipboard(json)
	setStatus("Layout copied to clipboard (JSON)", Color3.fromRGB(100, 255, 180))
end

local function loadLayout()
	local ok, data = pcall(function()
		return HttpService:JSONDecode(getclipboard())
	end)
	if ok and data and data.parts then
		ScannedLayout = data.parts
		if data.origin then
			HouseOrigin = CFrame.new(unpack(data.origin))
		end
		setStatus(string.format("Loaded %d parts from clipboard", #ScannedLayout), Color3.fromRGB(100, 255, 180))
	else
		setStatus("Invalid clipboard data", Color3.fromRGB(255, 80, 80))
	end
end

