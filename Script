-- ===================== CORE =====================

local function getBestHouse()
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
	local hrp = char.HumanoidRootPart

	local bestModel, bestScore = nil, -1

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") then
			local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
			if primary then
				local dist = (primary.Position - hrp.Position).Magnitude
				if dist < 55 then
					-- Prefer models that contain many parts (real houses)
					local partCount = 0
					for _, d in ipairs(obj:GetDescendants()) do
						if d:IsA("BasePart") then
							partCount += 1
							if partCount > 40 then break end
						end
					end
					local score = partCount * 10 - dist
					if score > bestScore then
						bestScore = score
						bestModel = obj
					end
				end
			end
		end
	end
	return bestModel
end

local function scanHouse()
	if isScanning then return end
	isScanning = true
	ScannedLayout = {}
	estimatedCost = 0
	HouseName = "Unknown"
	setProgress(0)
	setStatus("Looking for house…", Color3.fromRGB(0, 180, 255))
	updateInfo()

	local house = getBestHouse()
	if not house then
		setStatus("No house found. Stand fully inside a room.", Color3.fromRGB(255, 90, 90))
		isScanning = false
		return
	end

	HouseName = house.Name
	if HouseName == "" or HouseName == "Model" then
		HouseName = "Custom / Unnamed House"
	end

	local cf, size = house:GetBoundingBox()
	HouseOrigin = cf

	setStatus("Collecting interior parts…", Color3.fromRGB(0, 180, 255))

	local parts = {}
	local seen = {}

	-- Main deep scan
	for _, desc in ipairs(house:GetDescendants()) do
		if desc:IsA("BasePart") and not seen[desc] then
			seen[desc] = true
			-- Filter out pure invisibles / character parts
			if desc.Transparency < 0.98 and not desc:IsDescendantOf(LocalPlayer.Character) then
				table.insert(parts, desc)
			end
		end
	end

	-- Extra nearby furniture (some houses keep furniture outside the main model)
	for _, obj in ipairs(workspace:GetChildren()) do
		if obj:IsA("Model") and obj ~= house and not seen[obj] then
			local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
			if primary then
				local dist = (primary.Position - cf.Position).Magnitude
				if dist < (size.Magnitude * 0.6 + 20) then
					for _, desc in ipairs(obj:GetDescendants()) do
						if desc:IsA("BasePart") and not seen[desc] and desc.Transparency < 0.98 then
							seen[desc] = true
							table.insert(parts, desc)
						end
					end
				end
			end
		end
	end

	local total = #parts
	if total == 0 then
		setStatus("0 parts found. Try standing deeper inside.", Color3.fromRGB(255, 140, 50))
		isScanning = false
		updateInfo()
		return
	end

	setStatus(string.format("Scanning %d parts…", total), Color3.fromRGB(0, 180, 255))

	for i, part in ipairs(parts) do
		local rel = HouseOrigin:ToObjectSpace(part.CFrame)
		table.insert(ScannedLayout, {
			rel = {rel:GetComponents()},
			size = {part.Size.X, part.Size.Y, part.Size.Z},
			color = {part.Color.R, part.Color.G, part.Color.B},
			material = tostring(part.Material),
			transparency = part.Transparency,
			name = part.Name,
			class = part.ClassName,
			anchored = part.Anchored,
			cancollide = part.CanCollide
		})

		-- Live update every 25 parts so it never looks frozen
		if i % 25 == 0 or i == total then
			setProgress(i / total)
			setStatus(string.format("Scanning… %d / %d", i, total), Color3.fromRGB(0, 180, 255))
			estimatedCost = math.floor(#ScannedLayout * AVG_FURNITURE_PRICE)
			updateInfo()
			RunService.Heartbeat:Wait()
		end
	end

	estimatedCost = math.floor(#ScannedLayout * AVG_FURNITURE_PRICE)
	setProgress(1)
	setStatus(string.format("Done! %d furniture scanned", #ScannedLayout), Color3.fromRGB(80, 255, 140))
	updateInfo()
	isScanning = false
end

local function clearGhost()
	if GhostFolder then
		GhostFolder:Destroy()
		GhostFolder = nil
	end
end

local function spawnGhost()
	if #ScannedLayout == 0 then
		setStatus("Scan first", Color3.fromRGB(255, 100, 100))
		return
	end
	clearGhost()

	GhostFolder = Instance.new("Folder")
	GhostFolder.Name = "GhostPreview"
	GhostFolder.Parent = workspace

	local origin = HouseOrigin
	setStatus("Building ghost preview…", Color3.fromRGB(180, 200, 255))

	for i, data in ipairs(ScannedLayout) do
		local part = Instance.new(data.class == "MeshPart" and "Part" or (data.class or "Part"))
		part.Size = Vector3.new(unpack(data.size))
		part.Color = Color3.new(unpack(data.color))
		pcall(function() part.Material = Enum.Material[data.material:match("%.(.+)$") or data.material] end)
		part.Transparency = 0.42
		part.Anchored = true
		part.CanCollide = false
		part.CastShadow = false
		part.Name = data.name or "Ghost"

		local rel = CFrame.new(unpack(data.rel))
		part.CFrame = origin * rel
		part.Parent = GhostFolder

		if i % 60 == 0 then
			setProgress(i / #ScannedLayout)
			RunService.Heartbeat:Wait()
		end
	end

	setProgress(1)
	setStatus(string.format("Ghost active (%d parts) – free / client only", #ScannedLayout), Color3.fromRGB(160, 210, 255))
end

local function realPlace()
	if #ScannedLayout == 0 then
		setStatus("Scan a house first", Color3.fromRGB(255, 100, 100))
		return
	end
	setStatus("Real place needs the current game remotes (they change often).\nUse Ghost for free preview.", Color3.fromRGB(255, 180, 60))
end

local function tpToPlayer()
	local others = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then table.insert(others, p) end
	end
	if #others == 0 then
		setStatus("No other players in server", Color3.fromRGB(255, 100, 100))
		return
	end
	local target = others[math.random(1, #others)]
	if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
		LocalPlayer.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame + Vector3.new(0, 6, 0)
		setStatus("Teleported near " .. target.Name, Color3.fromRGB(180, 130, 255))
	end
end

local function saveLayout()
	if #ScannedLayout == 0 then return end
	local payload = {
		house = HouseName,
		count = #ScannedLayout,
		cost = estimatedCost,
		origin = {HouseOrigin:GetComponents()},
		parts = ScannedLayout
	}
	setclipboard(HttpService:JSONEncode(payload))
	setStatus("Layout + info copied to clipboard", Color3.fromRGB(100, 255, 180))
end

