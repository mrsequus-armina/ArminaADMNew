-- ===================== CORE LOGIC =====================

local function getHouseRoot(player)
    -- Common paths used by current house systems
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    -- Prefer houses near the player
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:find("House") or obj.Name:find("Home") or obj:GetAttribute("Owner") == player.Name) then
            local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if primary and (primary.Position - hrp.Position).Magnitude < 80 then
                return obj
            end
        end
    end
    return nil
end

local function scanHouse(targetPlayer)
    ScannedLayout = {}
    local root = getHouseRoot(targetPlayer or LocalPlayer)
    if not root then
        -- fallback: scan everything near local player
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then
            setStatus("No character / no house found", Color3.fromRGB(255, 100, 100))
            return 0
        end
        root = workspace
    end

    local count = 0
    local origin = root:IsA("Model") and (root.PrimaryPart and root.PrimaryPart.Position or root:GetPivot().Position) or Vector3.zero

    for _, part in ipairs(root:GetDescendants()) do
        if part:IsA("BasePart") and not part:IsA("Terrain") then
            -- skip character parts & very large map pieces
            if part.Size.Magnitude < 120 and part.Transparency < 0.95 then
                local relCF = CFrame.new(origin):ToObjectSpace(part.CFrame)
                table.insert(ScannedLayout, {
                    Name = part.Name,
                    Class = part.ClassName,
                    RelCFrame = {relCF:GetComponents()},
                    Size = {part.Size.X, part.Size.Y, part.Size.Z},
                    Color = {part.Color.R, part.Color.G, part.Color.B},
                    Material = part.Material.Name,
                    Transparency = part.Transparency,
                    CanCollide = part.CanCollide,
                    Anchored = part.Anchored,
                })
                count += 1
            end
        end
    end

    setStatus(string.format("Scanned %d parts", count), Color3.fromRGB(100, 220, 140))
    setProgress(1)
    task.delay(0.4, function() setProgress(0) end)
    return count
end

local function clearGhost()
    if GhostFolder then
        GhostFolder:Destroy()
        GhostFolder = nil
    end
    GhostActive = false
    setStatus("Ghost cleared", Color3.fromRGB(180, 180, 200))
end

local function spawnGhost()
    if #ScannedLayout == 0 then
        setStatus("Scan first", Color3.fromRGB(255, 140, 80))
        return
    end
    clearGhost()

    GhostFolder = Instance.new("Folder")
    GhostFolder.Name = "GhostHousePreview"
    GhostFolder.Parent = workspace

    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local base = hrp and hrp.CFrame or CFrame.new(0, 10, 0)

    local total = #ScannedLayout
    for i, data in ipairs(ScannedLayout) do
        local p = Instance.new("Part")
        p.Name = "Ghost_" .. data.Name
        p.Size = Vector3.new(unpack(data.Size))
        p.Color = Color3.new(unpack(data.Color))
        p.Material = Enum.Material[data.Material] or Enum.Material.Plastic
        p.Transparency = math.max(data.Transparency, 0.35)   -- always slightly see-through
        p.CanCollide = false
        p.Anchored = true
        p.CastShadow = false

        local rel = CFrame.new(unpack(data.RelCFrame))
        p.CFrame = base * rel
        p.Parent = GhostFolder

        if i % 40 == 0 then
            setProgress(i / total)
            setStatus(string.format("Ghost placing %d / %d", i, total))
            task.wait()
        end
    end

    GhostActive = true
    setProgress(1)
    setStatus(string.format("Ghost ready · %d parts (free · client only)", total), Color3.fromRGB(160, 130, 255))
    task.delay(0.6, function() setProgress(0) end)
end

-- Real place attempt (matches video flow: buy → clear default → textures → furniture)
-- Exact remote names rotate; this uses the common patterns + a safe fallback message
local function realPlace()
    if #ScannedLayout == 0 then
        setStatus("Scan first", Color3.fromRGB(255, 140, 80))
        return
    end
    if IsPlacing then return end
    IsPlacing = true

    setStatus("Starting real place (costs bucks)...", Color3.fromRGB(255, 180, 80))
    setProgress(0.1)

    -- Attempt 1: look for known house-build remotes
    local function tryFire(path)
        local ok, remote = pcall(function()
            local cur = game
            for part in string.gmatch(path, "[^%.]+") do
                cur = cur:FindFirstChild(part) or cur:WaitForChild(part, 1)
            end
            return cur
        end)
        if ok and remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
            pcall(function()
                if remote:IsA("RemoteEvent") then
                    remote:FireServer(ScannedLayout)
                else
                    remote:InvokeServer(ScannedLayout)
                end
            end)
            return true
        end
        return false
    end

    -- Common paths used by public cloners (update if patched)
    local candidates = {
        "ReplicatedStorage.API.HouseAPI.PlaceFurniture",
        "ReplicatedStorage.Remotes.House.PlaceItems",
        "ReplicatedStorage.Network.HouseBuild",
        "ReplicatedStorage.ClientModules.Core.Interiors.Place",
    }

    local fired = false
    for _, path in ipairs(candidates) do
        if tryFire(path) then
            fired = true
            break
        end
    end

    -- Visual progress matching the video UI
    local steps = {"Buy house", "Clear default furniture", "Apply textures", "Place furniture", "Ambience"}
    for i, step in ipairs(steps) do
        setStatus(step .. "...")
        setProgress(i / #steps)
        task.wait(0.45)
    end

    if fired then
        setStatus("Place request sent · check inventory / house", Color3.fromRGB(100, 220, 140))
    else
        setStatus("Remotes not found this build · use Ghost + manual or update paths", Color3.fromRGB(255, 160, 80))
    end

    IsPlacing = false
    task.delay(1, function() setProgress(0) end)
end

local function tpToPlayer(name)
    local target = Players:FindFirstChild(name)
    if not target then
        setStatus("Player not found", Color3.fromRGB(255, 100, 100))
        return
    end

    local house = getHouseRoot(target)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if house then
        local primary = house.PrimaryPart or house:FindFirstChildWhichIsA("BasePart")
        if primary then
            hrp.CFrame = primary.CFrame + Vector3.new(0, 5, 0)
            setStatus("TP'd to " .. name .. "'s house", Color3.fromRGB(100, 200, 255))
            return
        end
    end

    -- fallback: TP near the player
    if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        hrp.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 6)
        setStatus("TP'd near " .. name .. " (house model not located)", Color3.fromRGB(200, 180, 100))
    end
end

