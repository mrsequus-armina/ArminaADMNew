-- ===================== PRICE HELPERS =====================
local function getFurnitureInfo(key)
	local d = key and FurnitureData[key]
	if d then return d[1], d[2] end
	return nil, nil
end

local function getFurniturePrice(key)
	local _, c = getFurnitureInfo(key)
	return c or 0
end

local function getHouseInfo(id)
	return HouseData[id] or HouseData[(id or ""):gsub("_", "")] -- "micro_2023" -> "micro2023"
		or (function()
			local low = string.lower((id or ""):gsub("_", ""))
			for k, v in pairs(HouseData) do
				if string.lower(k) == low then return v end
			end
		end)()
end

local function describeHouse(id)
	local h = getHouseInfo(id)
	if not h then return "Unknown house ID (price not in database)", 0 end
	local priceTxt
	if h.gamepass then
		priceTxt = "Gamepass: " .. h.gamepass
	elseif h.cost == 0 then
		priceTxt = "Free"
	else
		priceTxt = "$" .. tostring(h.cost)
	end
	local extra = h.addons and (" • " .. #h.addons .. " addons") or ""
	return h.name .. " • " .. priceTxt .. extra, h.cost or 0
end

-- Walk up from a part to find the furniture model it belongs to
local function findFurnitureModel(part)
	local cur = part
	while cur and cur ~= workspace do
		if FurnitureData[cur.Name] then return cur end
		cur = cur.Parent
	end
	return nil
end

